      ],
      "parameters": {
        "jsCode": "// Métadonnée « source » = nom du fichier : sert au filtrage par document dans l'analyse.\nreturn $input.all().map((item) => ({ json: { source: item.binary.data.fileName }, binary: item.binary }));"
