# Copier en .env puis remplacer les secrets (ex. : openssl rand -hex 32)

# Fichiers Compose chargés (voir le tutoriel 01, section 2) : décommenter UNE ligne au plus.
# Sans ligne, seul docker-compose.yml est chargé : Ollama sur le CPU (fonctionne partout, mais
# lentement), sans n8n. docker-compose.n8n.yml ajoute n8n, requis par le tutoriel 03.
# COMPOSE_FILE=docker-compose.yml:docker-compose.vulkan.yml   # GPU AMD ou Intel (Linux)
# COMPOSE_FILE=docker-compose.yml:docker-compose.nvidia.yml   # GPU NVIDIA (Linux, WSL2)
# COMPOSE_FILE=docker-compose.yml:docker-compose.n8n.yml      # CPU + n8n
# COMPOSE_FILE=docker-compose.yml:docker-compose.vulkan.yml:docker-compose.n8n.yml   # GPU AMD ou Intel + n8n
# COMPOSE_FILE=docker-compose.yml:docker-compose.nvidia.yml:docker-compose.n8n.yml   # GPU NVIDIA + n8n

# Profil vulkan uniquement : GID des groupes render/video de l'hôte (getent group render video)
RENDER_GID=992
VIDEO_GID=44

# Modèles Ollama
# granite4.2:8b : orienté RAG, tool calling, 128K ctx, ~5,3 Go sur disque, ~8 Go en mémoire
#   avec un contexte de 32k. Il faut donc ~8 Go libres en mémoire GPU (profil GPU) ou en RAM (CPU).
#   Configuration de référence (Radeon 780M, Vulkan, ~15,8 Go de mémoire partagée) :
#   lecture ~220 tok/s, génération ~14 tok/s, 100 % GPU.
# Machine plus modeste : réduire OLLAMA_CONTEXT_LENGTH à 16384, ou choisir un modèle plus petit
#   (https://ollama.com/library), à reporter aussi dans n8n/src/constants.mjs (tutoriel 03).
LLM_MODEL=granite4.2:8b
# bge-m3 : embeddings multilingues (FR/EN), dimension 1024
EMBED_MODEL=bge-m3
OLLAMA_CONTEXT_LENGTH=32768
# Plafond mémoire du conteneur Ollama : à garder sous la RAM de la machine
OLLAMA_MEM_LIMIT=20g

# Postgres (n8n + RAG) — mot de passe sans caractères spéciaux d'URL (@ : / ?)
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me
# Port de Postgres sur l'hôte (127.0.0.1 uniquement)
POSTGRES_HOST_PORT=5433

# Utilisé seulement si docker-compose.n8n.yml est chargé
N8N_ENCRYPTION_KEY=change-me
WEBUI_SECRET_KEY=change-me

# Compte administrateur d'Open WebUI, créé au premier démarrage. Il sert aussi au service open-webui-init,
# qui applique les réglages du tutoriel 01 au modèle de base. Laisser vide pour créer le compte dans
# l'interface et tout régler à la main.
WEBUI_ADMIN_EMAIL=admin@example.com
WEBUI_ADMIN_PASSWORD=change-me
# true : open-webui-init crée aussi la base « MBSE Expert » et l'assistant « Expert MBSE » (exercices des
# tutoriels 01 et 02). false : ces exercices restent à faire à la main.
OPENWEBUI_EXEMPLES=false
