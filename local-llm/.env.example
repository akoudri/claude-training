# Copier en .env puis remplacer les secrets (ex. : openssl rand -hex 32)

# Modèles Ollama
# granite4.2:8b : orienté RAG, tool calling, 128K ctx, ~5,3 Go, 100 % GPU sur la 780M
#   mesuré (doc de ~9,5k tokens) : lecture ~220 tok/s, génération ~14 tok/s
# Plafond pratique ~12 Go : la 780M n'adresse que ~15,8 Go (GTT) et, avec Vulkan,
# la partie d'un modèle laissée au CPU est aussi réservée en GTT -> pas de split GPU/CPU.
# (qwen3.8:27b testé : 18 Go, chargement GPU impossible, 13 min en CPU contre 2 min ici)
LLM_MODEL=granite4.2:8b
# bge-m3 : embeddings multilingues (FR/EN), dimension 1024
EMBED_MODEL=bge-m3
OLLAMA_CONTEXT_LENGTH=32768
OLLAMA_MEM_LIMIT=20g

# GID des groupes render/video de l'hôte : getent group render video
RENDER_GID=992
VIDEO_GID=44

# Postgres (n8n + RAG) — mot de passe sans caractères spéciaux d'URL (@ : / ?)
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me

N8N_ENCRYPTION_KEY=change-me
WEBUI_SECRET_KEY=change-me
