{
  "name": "Argos",
  "build": { "dockerfile": "Dockerfile" },
  "features": {
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },
  "remoteUser": "node",

  // Pare-feu sortant : remplace l'allowlist réseau du sandbox, inactif dans un conteneur.
  "runArgs": ["--cap-add=NET_ADMIN", "--cap-add=NET_RAW"],

  // Authentification persistante : volume nommé + CLAUDE_CONFIG_DIR, sans quoi
  // ~/.claude.json (le compte connecté) reste hors du volume et se perd au rebuild.
  "mounts": [
    "source=argos-claude-config-${devcontainerId},target=/home/node/.claude,type=volume"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/node/.claude"
  },

  // Le pare-feu passe AVANT npm ci, puis est rejoué à chaque démarrage.
  "postCreateCommand": "sudo chown -R node:node /home/node/.claude && sudo bash .devcontainer/init-firewall.sh && npm ci",
  "postStartCommand": "sudo bash .devcontainer/init-firewall.sh",

  "forwardPorts": [3000, 5173],
  "customizations": {
    "vscode": {
      "extensions": ["anthropic.claude-code", "dbaeumer.vscode-eslint", "vitest.explorer"]
    }
  }
}
