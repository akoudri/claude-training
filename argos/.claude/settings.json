{
  "permissions": {
    "deny": [
      "Read(/.env)",
      "Edit(/.env)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "filesystem": {
      "denyWrite": [
        "./migrations",
        "./.env"
      ]
    },
    "network": {
      "allowedDomains": [
        "registry.npmjs.org",
        "api.notifications-argos.example"
      ],
      "allowLocalBinding": true
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-migrations.mjs"
          }
        ]
      }
    ]
  }
}
